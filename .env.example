# Core production configuration
DATABASE_URL=
SESSION_SECRET=
ADMIN_PASSWORD=

# WNBA first-basket market feed
# Free/experimental ParlayAPI integration. If no live market is returned,
# PreziTools leaves sportsbook value unavailable instead of inventing odds.
PARLAY_API_KEY=

# MLB NRFI/YRFI market feed
# Optional HTTPS JSON endpoint returning RawMlbMarketQuote[] or { quotes: [...] }.
# Leave blank unless an authorized upstream market adapter is configured.
MLB_MARKET_SOURCE_URL=

# Newsletter / email
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
# Optional canonical base URL used in newsletter links and unsubscribe URLs.
NEWSLETTER_BASE_URL=https://prezitools.com
